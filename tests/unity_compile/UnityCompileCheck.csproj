<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the C# that the harness injects into recovered projects against a real Unity's managed DLLs,
    without opening Unity (no licence needed). Driven by tests/test_harness.py:
      dotnet build -p:UnityManaged=<dir with UnityEngine*.dll> -p:UnityDefines="UNITY_2020_1_OR_NEWER;..." -p:WithEditor=true
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);$(UnityDefines)</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Unity2Web\Runtime\**\*.cs" />
    <Compile Include="..\..\unity\Unity2Web\Editor\**\*.cs" Condition="'$(WithEditor)' == 'true'" />
    <Reference Include="$(UnityManaged)\*.dll" Exclude="$(UnityManaged)\netstandard.dll;$(UnityManaged)\mscorlib.dll;$(UnityManaged)\System*.dll;$(UnityManaged)\Mono*.dll" Private="false" />
    <Reference Include="$(ShimsDll)" Private="false" />
  </ItemGroup>

</Project>
